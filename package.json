{
  "name": "problet",
  "productName": "Problet",
  "version": "9.4.1",
  "description": "Problet — минимальный браузер на Electron",
  "main": "boot.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "author": "cersat",
  "homepage": "https://github.com/cersat/problet",
  "build": {
    "appId": "com.cersat.problet",
    "productName": "Problet",
    "executableName": "problet",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeCliInspectArguments": false,
      "enableNodeOptionsEnvironmentVariable": false
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "blocklist.txt",
      "icon.png",
      "icon-beta.png",
      "blocklist-paths.txt",
      "allowlist.txt",
      "plain-ua-sites.txt",
      "pages/**",
      "package.json",
      "!dist/**",
      "!build/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;WebBrowser",
      "icon": "icon.png",
      "synopsis": "Минимальный браузер",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ]
    },
    "artifactName": "Problet-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "nsis-web",
        "zip"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "include": "build/installer.nsh"
    },
    "nsisWeb": {
      "appPackageUrl": "https://github.com/cersat/Problet/releases/download/latest",
      "artifactName": "Problet-${version}-win-${arch}-web.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "identity": null
    },
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ]
  },
  "desktopName": "problet.desktop"
}
