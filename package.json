{
  "name": "problet",
  "productName": "Problet",
  "version": "8.5.7",
  "description": "Problet — минимальный браузер на Electron",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "author": "cersat",
  "homepage": "https://github.com/cersat/problet",
  "build": {
    "appId": "com.cersat.problet",
    "productName": "Problet",
    "executableName": "problet",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "*.js",
      "*.html",
      "*.css",
      "blocklist.txt",
      "icon.png",
      "blocklist-paths.txt",
      "allowlist.txt",
      "plain-ua-sites.txt",
      "pages/**",
      "package.json",
      "!dist/**",
      "!build/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Network;WebBrowser",
      "icon": "icon.png",
      "synopsis": "Минимальный браузер",
      "mimeTypes": [
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "text/html"
      ]
    },
    "artifactName": "Problet-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "icon.png",
      "identity": null
    }
  },
  "desktopName": "problet.desktop"
}